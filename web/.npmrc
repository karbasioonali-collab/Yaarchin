# تنظیمات نصب پکیج (لیارا و CI هم این فایل را می‌خوانند). registry اینجا تعیین نمی‌شود؛ لیارا mirror خودش را می‌گذارد.
# audit و fund خاموش: درخواست‌های اضافه‌ی شبکه که در build لیارا باعث گیر کردن npm شده بودند.
audit=false
fund=false
# تلاش دوباره در قطعی‌های موقت شبکه
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
